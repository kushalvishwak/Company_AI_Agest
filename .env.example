# Used by the kushal.ai desktop app. Prefer the hidden prompt in
# run_desktop.ps1; do not commit a real key here.
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=openai/gpt-oss-120b

# Used to sign/verify the demo's short-lived RBAC tokens (layer4_rbac).
# Change this for anything beyond local development.
RBAC_SIGNING_KEY=change-me-in-production
