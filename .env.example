# Everything below is optional. With none of it set, the stack runs
# fully offline using MockLLM + HashEmbedder (see src/agent_stack/layer1_identity
# and src/agent_stack/layer2_rag). Set these only to switch to a real model.

OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Used to sign/verify the demo's short-lived RBAC tokens (layer4_rbac).
# Change this for anything beyond local development.
RBAC_SIGNING_KEY=change-me-in-production
